# Google Gemini API Key (for response generation only)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (for response generation)
GEMINI_MODEL=gemini-1.5-flash

# Embedding Model (multilingual - supports Croatian)
# Options: paraphrase-multilingual-MiniLM-L12-v2, paraphrase-multilingual-mpnet-base-v2
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector Database
CHROMA_DB_PATH=./chroma_db

# PDF Documents
PDF_FOLDER_PATH=./pdfs

# RAG parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
